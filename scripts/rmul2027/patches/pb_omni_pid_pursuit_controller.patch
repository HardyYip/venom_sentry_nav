+// Regression paths are from C041 baseline-01 and candidate-envelope-01 failures.
+#include "pb_omni_pid_pursuit_controller/path_corner_lookahead.hpp"
+#include <iostream>
+#include <stdexcept>
+using pb_omni_pid_pursuit_controller::firstPathCorner;
+using Points = std::vector<std::pair<double, double>>;
+void require(bool condition, const char * message)
+{if (!condition) {throw std::runtime_error(message);}}
+int main()
+{
+  const Points recorded0 = {{0.040814778153198006,-0.008273852914137625},{0.09084791425421379,-0.05824067338404271},{0.09088106282604436,-0.10824065226242319},{0.09091421139787492,-0.15824063114080367},{0.04094737244052027,-0.20827376842765954},{0.0056154817793192535,-0.24365253908723272},{-0.029716408881885314,-0.2790313097468061},{-0.06504829954308633,-0.3144100804063793},{-0.10038019020428735,-0.3497888510659528},{-0.1357120808654919,-0.385167621725526},{-0.1710439715266947,-0.42054639238509917},{-0.20888682234625833,-0.4584394548619388},{-0.25362299523401255,-0.43610844231496704},{-0.29835916812176677,-0.41377742976799503},{-0.34309534100952277,-0.39144641722102347},{-0.4089530696066621,-0.35857213073907923},{-0.4589862057076797,-0.30860531026917426}};
+  const auto turn0 = firstPathCorner(recorded0, 0.5, 0.05);
+  require(turn0.has_value() && recorded0[*turn0].first > 0.0, "recorded obstacle detour must first steer right");
+  const Points recorded1 = {{-0.008240748980052004,0.03733075542371944},{0.041776854701822685,-0.012651562990557585},{0.09179445838369915,-0.06263388140483472},{0.0918120674740841,-0.11263383268588045},{0.041829681972979316,-0.162651416833695},{-0.008152703528125471,-0.21266900098150943},{-0.05813508902923026,-0.26268658512932386},{-0.10811747453033504,-0.3127041692771383},{-0.15809986003143806,-0.36272175342495283},{-0.20281333971929172,-0.38509818272766505},{-0.2580822401240326,-0.4127569704395361},{-0.2934500268661875,-0.3774141341493754},{-0.35811744748778196,-0.3127923336109818},{-0.40813505116965487,-0.26281001519670477}};
+  const auto turn1 = firstPathCorner(recorded1, 0.5, 0.05);
+  require(turn1.has_value() && recorded1[*turn1].first > 0.0, "recorded obstacle detour must first steer right");
+  require(!firstPathCorner(Points{{0,0},{0.1,0},{0.3,0},{0.6,0}}, 0.5, 0.05), "straight path unchanged");
+  const Points duplicates{{0,0},{0.15,0},{0.15,0},{0.15,0.2},{0.15,0.6}};
+  const auto duplicate_turn = firstPathCorner(duplicates, 0.5, 0.05);
+  require(duplicate_turn && duplicates[*duplicate_turn].first == 0.15 && duplicates[*duplicate_turn].second == 0.0, "duplicate vertices must not hide a turn");
+  require(!firstPathCorner(Points{{-0.1,0.01},{0,0.01},{0,0.2},{0,0.6}}, 0.5, 0.05), "reached turn must not be chased again");
+  require(!firstPathCorner(Points{{0,0},{0.1,0.1}}, 0.5, 0.05), "short final segment unchanged");
+  require(!firstPathCorner(Points{{0,0},{0,0},{0,0}}, 0.5, 0.05), "degenerate path has no artificial turn");
+  std::cout << "path corner contracts: 7 passed\n";
+}
