@@ -0,0 +1,53 @@
+// Copyright 2026 HardyYip contributors
+// SPDX-License-Identifier: Apache-2.0
+#ifndef PB_OMNI_PID_PURSUIT_CONTROLLER__PATH_CORNER_LOOKAHEAD_HPP_
+#define PB_OMNI_PID_PURSUIT_CONTROLLER__PATH_CORNER_LOOKAHEAD_HPP_
+#include <cmath>
+#include <cstddef>
+#include <optional>
+#include <utility>
+#include <vector>
+namespace pb_omni_pid_pursuit_controller
+{
+// Return the first unreached bend before the ordinary lookahead target.
+// A reached bend must be skipped so tracking can continue onto its next segment.
+inline std::optional<std::size_t> firstPathCorner(
+  const std::vector<std::pair<double, double>> & points, double lookahead,
+  double reached_distance)
+{
+  if (points.size() < 3 || !std::isfinite(lookahead) || lookahead <= 0.0) {
+    return std::nullopt;
+  }
+  std::size_t target = points.size() - 1;
+  for (std::size_t i = 0; i < points.size(); ++i) {
+    if (std::hypot(points[i].first, points[i].second) >= lookahead) {
+      target = i;
+      break;
+    }
+  }
+  constexpr double epsilon = 1e-8;
+  const double cosine_threshold = std::cos(3.14159265358979323846 / 8.0);
+  std::size_t previous = 0;
+  for (std::size_t i = 1; i < target && i + 1 < points.size(); ++i) {
+    const double ax = points[i].first - points[previous].first;
+    const double ay = points[i].second - points[previous].second;
+    const double before = std::hypot(ax, ay);
+    if (before <= epsilon) {continue;}
+    std::size_t next = i + 1;
+    while (next < points.size() &&
+      std::hypot(points[next].first - points[i].first,
+      points[next].second - points[i].second) <= epsilon)
+    {++next;}
+    if (next == points.size()) {break;}
+    const double bx = points[next].first - points[i].first;
+    const double by = points[next].second - points[i].second;
+    const double after = std::hypot(bx, by);
+    if (std::hypot(points[i].first, points[i].second) > reached_distance &&
+      (ax * bx + ay * by) / (before * after) < cosine_threshold)
+    {return i;}
+    previous = i;
+  }
+  return std::nullopt;
+}
+}  // namespace pb_omni_pid_pursuit_controller
+#endif  // PB_OMNI_PID_PURSUIT_CONTROLLER__PATH_CORNER_LOOKAHEAD_HPP_
diff --git a/include/pb_omni_pid_pursuit_controller/pose_velocity_estimator.hpp b/include/pb_omni_pid_pursuit_controller/pose_velocity_estimator.hpp
