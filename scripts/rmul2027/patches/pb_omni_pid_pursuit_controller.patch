diff --git a/include/pb_omni_pid_pursuit_controller/collision_checked_lookahead.hpp b/include/pb_omni_pid_pursuit_controller/collision_checked_lookahead.hpp
new file mode 100644
index 0000000..24107dc
--- /dev/null
+++ b/include/pb_omni_pid_pursuit_controller/collision_checked_lookahead.hpp
@@ -0,0 +1,49 @@
+// Copyright 2026 HardyYip contributors
+// SPDX-License-Identifier: Apache-2.0
+#ifndef PB_OMNI_PID_PURSUIT_CONTROLLER__COLLISION_CHECKED_LOOKAHEAD_HPP_
+#define PB_OMNI_PID_PURSUIT_CONTROLLER__COLLISION_CHECKED_LOOKAHEAD_HPP_
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <optional>
+#include <utility>
+#include <vector>
+namespace pb_omni_pid_pursuit_controller
+{
+template<class IsSafe>
+bool collisionFreeSegment(
+  double x0, double y0, double x1, double y1, double resolution, IsSafe is_safe)
+{
+  if (!std::isfinite(x0) || !std::isfinite(y0) || !std::isfinite(x1) ||
+    !std::isfinite(y1) || !std::isfinite(resolution) || resolution <= 0.0)
+  {return false;}
+  const auto count = std::max<std::size_t>(
+    1, static_cast<std::size_t>(std::ceil(std::hypot(x1 - x0, y1 - y0) / (0.5 * resolution))));
+  for (std::size_t i = 0; i <= count; ++i) {
+    const double fraction = static_cast<double>(i) / count;
+    if (!is_safe(x0 + fraction * (x1 - x0), y0 + fraction * (y1 - y0))) {return false;}
+  }
+  return true;
+}
+template<class IsSafe>
+std::optional<std::size_t> collisionCheckedTarget(
+  const std::vector<std::pair<double, double>> & targets, double x0, double y0,
+  double resolution, IsSafe is_safe)
+{
+  for (std::size_t i = targets.size(); i > 0; --i) {
+    const auto & target = targets[i - 1];
+    if (std::hypot(target.first - x0, target.second - y0) < 0.5 * resolution) {continue;}
+    if (collisionFreeSegment(x0, y0, target.first, target.second, resolution, is_safe)) {
+      return i - 1;
+    }
+  }
+  return std::nullopt;
+}
+inline double shortTargetSpeedLimit(double target_distance, double reaction_time)
+{
+  if (!std::isfinite(target_distance) || !std::isfinite(reaction_time) ||
+    target_distance <= 0.0 || reaction_time <= 0.0) {return 0.0;}
+  return target_distance / reaction_time;
+}
+}  // namespace pb_omni_pid_pursuit_controller
+#endif  // PB_OMNI_PID_PURSUIT_CONTROLLER__COLLISION_CHECKED_LOOKAHEAD_HPP_
diff --git a/include/pb_omni_pid_pursuit_controller/geodesic_goal_field.hpp b/include/pb_omni_pid_pursuit_controller/geodesic_goal_field.hpp
new file mode 100644
index 0000000..8b9a781
--- /dev/null
+++ b/include/pb_omni_pid_pursuit_controller/geodesic_goal_field.hpp
@@ -0,0 +1,188 @@
+#ifndef PB_OMNI_GEODESIC_GOAL_FIELD_HPP_
+#define PB_OMNI_GEODESIC_GOAL_FIELD_HPP_
+#include "pb_omni_pid_pursuit_controller/spin_coverage.hpp"
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <limits>
+#include <vector>
+#include <queue>
+#include <functional>
+#include <utility>
+namespace pb_omni_pid_pursuit_controller::goal_field
+{
+struct Point {double x, y;};
+class Potential
+{
+  c041_spin::GridView grid_;
+  double radius_{0.0}, unreachable_{1.0};
+  std::vector<unsigned char> safe_;
+  std::vector<double> values_, travel_cost_;
+  int target_plan_index_{-1};
+  static void transformLine(const std::vector<double> & f, std::vector<double> & out)
+  {
+    const int n = static_cast<int>(f.size());
+    std::vector<int> v(n);
+    std::vector<double> z(n + 1);
+    int k = -1;
+    for (int q = 0; q < n; ++q) {
+      if (f[q] >= 1.0e11) {continue;}
+      double s = -std::numeric_limits<double>::infinity();
+      while (k >= 0) {
+        s = ((f[q] + q * q) - (f[v[k]] + v[k] * v[k])) / (2.0 * (q - v[k]));
+        if (s > z[k]) {break;}
+        --k;
+      }
+      ++k; v[k] = q;
+      z[k] = k == 0 ? -std::numeric_limits<double>::infinity() : s;
+      z[k + 1] = std::numeric_limits<double>::infinity();
+    }
+    out.assign(n, 1.0e12);
+    if (k < 0) {return;}
+    k = 0;
+    for (int q = 0; q < n; ++q) {
+      while (z[k + 1] < q) {++k;}
+      const double delta = q - v[k];
+      out[q] = delta * delta + f[v[k]];
+    }
+  }
+  Point center(int index) const
+  {
+    return {grid_.origin_x + (index % grid_.width + 0.5) * grid_.resolution,
+      grid_.origin_y + (index / grid_.width + 0.5) * grid_.resolution};
+  }
+  bool connected(Point a, Point b) const
+  {
+    const int steps = std::max(1, static_cast<int>(std::ceil(
+      std::hypot(b.x - a.x, b.y - a.y) / (0.5 * grid_.resolution))));
+    for (int i = 0; i <= steps; ++i) {
+      const double t = static_cast<double>(i) / steps;
+      if (!c041_spin::circleClear(grid_, a.x + t * (b.x - a.x),
+        a.y + t * (b.y - a.y), radius_)) {return false;}
+    }
+    return true;
+  }
+  std::vector<int> anchors(Point p) const
+  {
+    std::vector<int> result;
+    if (!std::isfinite(p.x) || !std::isfinite(p.y) ||
+      !c041_spin::circleClear(grid_, p.x, p.y, radius_)) {return result;}
+    const int mx = static_cast<int>(std::floor((p.x - grid_.origin_x) / grid_.resolution));
+    const int my = static_cast<int>(std::floor((p.y - grid_.origin_y) / grid_.resolution));
+    for (int y = my - 1; y <= my + 1; ++y) {
+      for (int x = mx - 1; x <= mx + 1; ++x) {
+        if (x < 0 || y < 0 || x >= grid_.width || y >= grid_.height) {continue;}
+        const int i = y * grid_.width + x;
+        if (safe_[i] && connected(p, center(i))) {result.push_back(i);}
+      }
+    }
+    std::sort(result.begin(), result.end(), [&](int a, int b) {
+      const auto u = center(a), v = center(b);
+      return std::hypot(u.x - p.x, u.y - p.y) < std::hypot(v.x - p.x, v.y - p.y);
+    });
+    return result;
+  }
+  template<class F> void neighbors(int i, F function) const
+  {
+    const int x = i % grid_.width, y = i / grid_.width;
+    if (x > 0) {function(i - 1);}
+    if (x + 1 < grid_.width) {function(i + 1);}
+    if (y > 0) {function(i - grid_.width);}
+    if (y + 1 < grid_.height) {function(i + grid_.width);}
+  }
+public:
+  bool prepare(const c041_spin::GridView & grid, Point pose,
+    const std::vector<Point> & plan, double radius)
+  {
+    grid_ = grid; radius_ = radius; target_plan_index_ = -1;
+    const int n = std::max(0, grid.width) * std::max(0, grid.height);
+    unreachable_ = 2.0 * n + 1.0;
+    safe_.assign(n, 0); values_.assign(n, unreachable_); travel_cost_.assign(n, 1.0);
+    if (!grid.data || grid.width < 2 || grid.height < 2 ||
+      !std::isfinite(grid.resolution) || grid.resolution <= 0.0 ||
+      !std::isfinite(radius) || radius < 0.0) {return false;}
+    std::vector<double> squared(n), line, transformed;
+    for (int y = 0; y < grid.height; ++y) {
+      line.resize(grid.width);
+      for (int x = 0; x < grid.width; ++x) {
+        line[x] = c041_spin::hardCost(c041_spin::at(grid, x, y)) ? 0.0 : 1.0e12;
+      }
+      transformLine(line, transformed);
+      for (int x = 0; x < grid.width; ++x) {squared[y * grid.width + x] = transformed[x];}
+    }
+    for (int x = 0; x < grid.width; ++x) {
+      line.resize(grid.height);
+      for (int y = 0; y < grid.height; ++y) {line[y] = squared[y * grid.width + x];}
+      transformLine(line, transformed);
+      for (int y = 0; y < grid.height; ++y) {
+        const int i = y * grid.width + x;
+        const auto p = center(i);
+        const int min_x = static_cast<int>(std::floor((p.x - radius - grid.origin_x) / grid.resolution));
+        const int max_x = static_cast<int>(std::ceil((p.x + radius - grid.origin_x) / grid.resolution));
+        const int min_y = static_cast<int>(std::floor((p.y - radius - grid.origin_y) / grid.resolution));
+        const int max_y = static_cast<int>(std::ceil((p.y + radius - grid.origin_y) / grid.resolution));
+        safe_[i] = min_x >= 0 && min_y >= 0 && max_x < grid.width && max_y < grid.height &&
+          transformed[y] * grid.resolution * grid.resolution > radius * radius;
+        const double clearance = std::min({std::sqrt(transformed[y]) * grid.resolution,
+          p.x - grid.origin_x, p.y - grid.origin_y,
+          grid.origin_x + grid.width * grid.resolution - p.x,
+          grid.origin_y + grid.height * grid.resolution - p.y});
+        const double reserve = 2.0 * grid.resolution;
+        const double factor = std::clamp((radius + reserve - clearance) / reserve, 0.0, 1.0);
+        travel_cost_[i] = 1.0 + factor * factor;
+      }
+    }
+    auto seeds = anchors(pose);
+    if (seeds.empty()) {return false;}
+    std::vector<unsigned char> reachable(n, 0);
+    std::vector<int> queue; queue.reserve(n);
+    for (int i : seeds) {reachable[i] = 1; queue.push_back(i);}
+    for (std::size_t head = 0; head < queue.size(); ++head) {
+      neighbors(queue[head], [&](int j) {
+        if (safe_[j] && !reachable[j]) {reachable[j] = 1; queue.push_back(j);}
+      });
+    }
+    int target = -1;
+    for (int k = static_cast<int>(plan.size()) - 1; k >= 0 && target < 0; --k) {
+      for (int i : anchors(plan[k])) {
+        if (reachable[i]) {target = i; target_plan_index_ = k; break;}
+      }
+    }
+    if (target < 0) {return false;}
+    using Entry = std::pair<double, int>;
+    std::priority_queue<Entry, std::vector<Entry>, std::greater<Entry>> pending;
+    values_[target] = 0.0; pending.push({0.0, target});
+    while (!pending.empty()) {
+      const auto [distance, i] = pending.top(); pending.pop();
+      if (distance > values_[i]) {continue;}
+      neighbors(i, [&](int j) {
+        const double next = distance + 0.5 * (travel_cost_[i] + travel_cost_[j]);
+        if (safe_[j] && next < values_[j]) {
+          values_[j] = next; pending.push({next, j});
+        }
+      });
+    }
+    return true;
+  }
+  double score(double x, double y) const
+  {
+    if (values_.empty() || !std::isfinite(x) || !std::isfinite(y) || grid_.resolution <= 0.0) {
+      return unreachable_;
+    }
+    const double gx = (x - grid_.origin_x) / grid_.resolution - 0.5;
+    const double gy = (y - grid_.origin_y) / grid_.resolution - 0.5;
+    const int ix = static_cast<int>(std::floor(gx)), iy = static_cast<int>(std::floor(gy));
+    if (ix < 0 || iy < 0 || ix + 1 >= grid_.width || iy + 1 >= grid_.height) {
+      return unreachable_;
+    }
+    const double fx = gx - ix, fy = gy - iy;
+    const int i = iy * grid_.width + ix;
+    return (1.0 - fy) * ((1.0 - fx) * values_[i] + fx * values_[i + 1]) +
+      fy * ((1.0 - fx) * values_[i + grid_.width] + fx * values_[i + grid_.width + 1]);
+  }
+  bool safeCell(int x, int y) const {return safe_.at(y * grid_.width + x) != 0;}
+  int targetPlanIndex() const {return target_plan_index_;}
+  double unreachableScore() const {return unreachable_;}
+};
+}
+#endif
