@@ -0,0 +1,46 @@
+// Copyright 2026 HardyYip contributors
+// SPDX-License-Identifier: Apache-2.0
+#ifndef PB_OMNI_PID_PURSUIT_CONTROLLER__POSE_VELOCITY_ESTIMATOR_HPP_
+#define PB_OMNI_PID_PURSUIT_CONTROLLER__POSE_VELOCITY_ESTIMATOR_HPP_
+#include <cmath>
+#include <deque>
+#include <utility>
+namespace pb_omni_pid_pursuit_controller
+{
+class PoseVelocityEstimator
+{
+  struct Sample {double t, x, y;};
+  std::deque<Sample> samples_;
+  double vx_{0.0}, vy_{0.0};
+public:
+  void reset() {samples_.clear(); vx_ = 0.0; vy_ = 0.0;}
+  std::pair<double, double> update(double stamp, double x, double y, double yaw)
+  {
+    if (!std::isfinite(stamp) || !std::isfinite(x) || !std::isfinite(y) || !std::isfinite(yaw)) {
+      reset(); return {0.0, 0.0};
+    }
+    if (!samples_.empty() && (stamp < samples_.back().t || stamp - samples_.back().t > 0.5)) {
+      reset();
+    }
+    if (samples_.empty() || stamp > samples_.back().t + 1e-6) {
+      samples_.push_back({stamp, x, y});
+      while (samples_.size() > 2 && stamp - samples_.front().t > 0.15) {samples_.pop_front();}
+      if (samples_.size() > 1) {
+        double mt = 0.0, mx = 0.0, my = 0.0;
+        const double origin = samples_.front().t;
+        for (const auto & s : samples_) {mt += s.t - origin; mx += s.x; my += s.y;}
+        mt /= samples_.size(); mx /= samples_.size(); my /= samples_.size();
+        double tt = 0.0, tx = 0.0, ty = 0.0;
+        for (const auto & s : samples_) {
+          const double dt = s.t - origin - mt;
+          tt += dt * dt; tx += dt * (s.x - mx); ty += dt * (s.y - my);
+        }
+        if (tt > 1e-12) {vx_ = tx / tt; vy_ = ty / tt;}
+      }
+    }
+    return {std::cos(yaw) * vx_ + std::sin(yaw) * vy_,
+      -std::sin(yaw) * vx_ + std::cos(yaw) * vy_};
+  }
+};
+}  // namespace pb_omni_pid_pursuit_controller
+#endif  // PB_OMNI_PID_PURSUIT_CONTROLLER__POSE_VELOCITY_ESTIMATOR_HPP_
diff --git a/include/pb_omni_pid_pursuit_controller/spin_coverage.hpp b/include/pb_omni_pid_pursuit_controller/spin_coverage.hpp
new file mode 100755
index 0000000..89385cb
--- /dev/null
+++ b/include/pb_omni_pid_pursuit_controller/spin_coverage.hpp
@@ -0,0 +1,96 @@
+// Minimal geometry kernel for spin-sweep clearance tests (no ROS deps).
+#ifndef C041_SPIN_COVERAGE_HPP_
+#define C041_SPIN_COVERAGE_HPP_
+#include <cmath>
+#include <cstddef>
+#include <algorithm>
+
+namespace c041_spin
+{
+struct GridView
+{
+  double origin_x{0.0};
+  double origin_y{0.0};
+  double resolution{0.05};
+  int width{0};
+  int height{0};
+  const unsigned char * data{nullptr};
+};
+
+inline unsigned char at(const GridView & grid, int mx, int my)
+{
+  return grid.data[static_cast<std::size_t>(my) * grid.width + mx];
+}
+
+// Lethal or unknown: 254 lethal, 255 unknown/no-information. 253 is inscribed
+// inflation and is intentionally not a hard collision here; it is not silently
+// treated as free either: the caller keeps the full spinning envelope.
+inline bool hardCost(unsigned char c) {return c >= 254;}
+
+inline bool circleClear(
+  const GridView & grid, double x, double y, double radius)
+{
+  const double r2 = radius * radius;
+  const int min_x = static_cast<int>(std::floor((x - radius - grid.origin_x) / grid.resolution));
+  const int max_x = static_cast<int>(std::ceil((x + radius - grid.origin_x) / grid.resolution));
+  const int min_y = static_cast<int>(std::floor((y - radius - grid.origin_y) / grid.resolution));
+  const int max_y = static_cast<int>(std::ceil((y + radius - grid.origin_y) / grid.resolution));
+  if (min_x < 0 || min_y < 0 || max_x >= grid.width || max_y >= grid.height) {
+    return false;
+  }
+  for (int my = min_y; my <= max_y; ++my) {
+    for (int mx = min_x; mx <= max_x; ++mx) {
+      const double cx = grid.origin_x + (mx + 0.5) * grid.resolution;
+      const double cy = grid.origin_y + (my + 0.5) * grid.resolution;
+      const double dx = cx - x, dy = cy - y;
+      if (dx * dx + dy * dy <= r2 && hardCost(at(grid, mx, my))) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+inline double nearestHardDistance(
+  const GridView & grid, double x, double y, double cap)
+{
+  double best = std::min({cap, x - grid.origin_x, y - grid.origin_y,
+    grid.origin_x + grid.width * grid.resolution - x,
+    grid.origin_y + grid.height * grid.resolution - y});
+  const int min_x = std::max(0, static_cast<int>(std::floor((x - cap - grid.origin_x) / grid.resolution)));
+  const int max_x = std::min(grid.width - 1, static_cast<int>(std::ceil((x + cap - grid.origin_x) / grid.resolution)));
+  const int min_y = std::max(0, static_cast<int>(std::floor((y - cap - grid.origin_y) / grid.resolution)));
+  const int max_y = std::min(grid.height - 1, static_cast<int>(std::ceil((y + cap - grid.origin_y) / grid.resolution)));
+  double squared = best * best;
+  for (int my = min_y; my <= max_y; ++my) {
+    for (int mx = min_x; mx <= max_x; ++mx) {
+      if (!hardCost(at(grid, mx, my))) {continue;}
+      const double dx = grid.origin_x + (mx + 0.5) * grid.resolution - x;
+      const double dy = grid.origin_y + (my + 0.5) * grid.resolution - y;
+      squared = std::min(squared, dx * dx + dy * dy);
+    }
+  }
+  return std::sqrt(squared);
+}
+
+// The old fixed rectangle check, in the non-spinning fake frame. It treats
+// inscribed inflation (253) as collision and does not rotate with the chassis.
+inline bool fixedRectangleClear(
+  const GridView & grid, double x, double y, double yaw,
+  double half_x, double half_y, double padding)
+{
+  const double c = std::cos(yaw), s = std::sin(yaw);
+  const double hx = half_x + padding, hy = half_y + padding;
+  const double local[5][2] = {{0, 0}, {hx, hy}, {hx, -hy}, {-hx, -hy}, {-hx, hy}};
+  for (const auto & p : local) {
+    const double wx = x + c * p[0] - s * p[1];
+    const double wy = y + s * p[0] + c * p[1];
+    const int mx = static_cast<int>(std::floor((wx - grid.origin_x) / grid.resolution));
+    const int my = static_cast<int>(std::floor((wy - grid.origin_y) / grid.resolution));
+    if (mx < 0 || my < 0 || mx >= grid.width || my >= grid.height) {return false;}
+    if (at(grid, mx, my) >= 253) {return false;}
+  }
+  return true;
+}
+}  // namespace c041_spin
+#endif
diff --git a/src/collision_aware_omni_controller.cpp b/src/collision_aware_omni_controller.cpp
new file mode 100644
index 0000000..1998a73
--- /dev/null
+++ b/src/collision_aware_omni_controller.cpp
@@ -0,0 +1,220 @@
+// Copyright 2026 HardyYip contributors
+// SPDX-License-Identifier: Apache-2.0
+#include "dwb_core/dwb_local_planner.hpp"
+#include "dwb_core/exceptions.hpp"
+#include "dwb_core/trajectory_critic.hpp"
+#include "pb_omni_pid_pursuit_controller/pose_velocity_estimator.hpp"
+#include "pb_omni_pid_pursuit_controller/spin_coverage.hpp"
+#include "pb_omni_pid_pursuit_controller/geodesic_goal_field.hpp"
+#include "pluginlib/class_list_macros.hpp"
+#include "tf2/utils.h"
+#include "tf2_geometry_msgs/tf2_geometry_msgs.hpp"
+#include "nav2_core/exceptions.hpp"
+#include <cmath>
+#include <algorithm>
+#include <memory>
+namespace pb_omni_pid_pursuit_controller
+{
+class GoalAwareObstacleScore : public dwb_core::TrajectoryCritic
+{
+  dwb_core::TrajectoryCritic::Ptr original_;
+  dwb_core::TrajectoryCritic::Ptr path_distance_;
+  double resolution_;
+  double factor_{1.0};
+  double path_blend_{0.0};
+public:
+  GoalAwareObstacleScore(dwb_core::TrajectoryCritic::Ptr original,
+    dwb_core::TrajectoryCritic::Ptr path_distance, double resolution)
+  : original_(std::move(original)), path_distance_(std::move(path_distance)),
+    resolution_(resolution) {}
+  bool prepare(
+    const geometry_msgs::msg::Pose2D & pose,
+    const nav_2d_msgs::msg::Twist2D & velocity,
+    const geometry_msgs::msg::Pose2D & goal,
+    const nav_2d_msgs::msg::Path2D & plan) override
+  {
+    const double distance = std::hypot(goal.x - pose.x, goal.y - pose.y);
+    if (!std::isfinite(distance)) {
+      throw dwb_core::IllegalTrajectoryException(name_, "Nonfinite goal scoring distance");
+    }
+    factor_ = 0.1 + 0.9 * std::clamp(distance - 0.5, 0.0, 1.0);
+    path_blend_ = std::clamp((distance - 1.5) / 0.5, 0.0, 1.0);
+    return original_->prepare(pose, velocity, goal, plan);
+  }
+  double getScale() const override {return original_->getScale() * factor_;}
+  double scoreTrajectory(const dwb_msgs::msg::Trajectory2D & traj) override
+  {
+    const double obstacle_score = original_->scoreTrajectory(traj);
+    double maximum_distance = 0.0;
+    dwb_msgs::msg::Trajectory2D sample;
+    sample.poses.resize(1);
+    for (const auto & pose : traj.poses) {
+      sample.poses[0] = pose;
+      const double cells = path_distance_->scoreTrajectory(sample);
+      if (!std::isfinite(cells) || cells < 0.0) {
+        throw dwb_core::IllegalTrajectoryException(name_, "Invalid path distance score");
+      }
+      maximum_distance = std::max(maximum_distance, cells * resolution_);
+    }
+    const double alignment_factor = 0.1 + 0.9 *
+      std::clamp((maximum_distance - 0.1) / 0.2, 0.0, 1.0);
+    return obstacle_score * (1.0 - path_blend_ + path_blend_ * alignment_factor);
+  }
+  void reset() override {original_->reset();}
+  void debrief(const nav_2d_msgs::msg::Twist2D & velocity) override
+  {original_->debrief(velocity);}
+};
+
+class GeodesicGoalScore : public dwb_core::TrajectoryCritic
+{
+  dwb_core::TrajectoryCritic::Ptr original_;
+  goal_field::Potential potential_;
+public:
+  explicit GeodesicGoalScore(dwb_core::TrajectoryCritic::Ptr original)
+  : original_(std::move(original)) {}
+  bool prepare(const geometry_msgs::msg::Pose2D & pose,
+    const nav_2d_msgs::msg::Twist2D & velocity,
+    const geometry_msgs::msg::Pose2D & goal, const nav_2d_msgs::msg::Path2D & plan) override
+  {
+    const bool prepared = original_->prepare(pose, velocity, goal, plan);
+    auto * map = costmap_ros_->getCostmap();
+    const c041_spin::GridView grid{map->getOriginX(), map->getOriginY(), map->getResolution(),
+      static_cast<int>(map->getSizeInCellsX()), static_cast<int>(map->getSizeInCellsY()),
+      map->getCharMap()};
+    std::vector<goal_field::Point> points;
+    points.reserve(plan.poses.size());
+    for (const auto & p : plan.poses) {points.push_back({p.x, p.y});}
+    const bool reachable = potential_.prepare(grid, {pose.x, pose.y}, points, 0.382883794 + 0.05);
+    return prepared && reachable;
+  }
+  double getScale() const override {return original_->getScale();}
+  double scoreTrajectory(const dwb_msgs::msg::Trajectory2D & traj) override
+  {
+    original_->scoreTrajectory(traj);
+    if (traj.poses.empty()) {throw dwb_core::IllegalTrajectoryException(name_, "Empty trajectory");}
+    return potential_.score(traj.poses.back().x, traj.poses.back().y);
+  }
+  void reset() override {original_->reset(); potential_ = goal_field::Potential{};}
+  void debrief(const nav_2d_msgs::msg::Twist2D & velocity) override {original_->debrief(velocity);}
+};
+
+class SpinCoverageCritic : public dwb_core::TrajectoryCritic
+{
+public:
+  double getScale() const override {return 1.0;}
+
+  double scoreTrajectory(const dwb_msgs::msg::Trajectory2D & traj) override
+  {
+    auto * costmap = costmap_ros_->getCostmap();
+    if (costmap == nullptr) {
+      throw dwb_core::IllegalTrajectoryException(name_, "SpinCoverage costmap unavailable");
+    }
+    const c041_spin::GridView grid{
+      costmap->getOriginX(), costmap->getOriginY(), costmap->getResolution(),
+      static_cast<int>(costmap->getSizeInCellsX()),
+      static_cast<int>(costmap->getSizeInCellsY()), costmap->getCharMap()};
+    constexpr double kSpinRadius = 0.382883794 + 0.05;
+    for (const auto & pose : traj.poses) {
+      const double wx = pose.x;
+      const double wy = pose.y;
+      const bool clear = c041_spin::circleClear(grid, wx, wy, kSpinRadius);
+      RCLCPP_INFO_ONCE(
+        rclcpp::get_logger("SpinCoverageCritic"),
+        "SpinCoverage sample world=(%.3f,%.3f) radius=%.3f clear=%d",
+        wx, wy, kSpinRadius, static_cast<int>(clear));
+      if (!clear) {
+        throw dwb_core::IllegalTrajectoryException(name_, "SpinCoverage hits lethal/unknown");
+      }
+    }
+    return 0.0;
+  }
+};
+
+class CollisionAwareOmniController : public dwb_core::DWBLocalPlanner
+{
+  PoseVelocityEstimator estimator_;
+  std::string pose_frame_;
+  rclcpp_lifecycle::LifecyclePublisher<geometry_msgs::msg::TwistStamped>::SharedPtr velocity_pub_;
+
+protected:
+  void loadCritics() override
+  {
+    dwb_core::DWBLocalPlanner::loadCritics();
+    auto node = node_.lock();
+    if (!node) {return;}
+    dwb_core::TrajectoryCritic::Ptr path_distance;
+    for (const auto & existing : critics_) {
+      if (existing->getName() == "PathDist") {path_distance = existing;}
+    }
+    if (!path_distance || !costmap_ros_ || !costmap_ros_->getCostmap()) {
+      throw nav2_core::PlannerException("Path distance and costmap required for obstacle scoring");
+    }
+    for (auto & existing : critics_) {
+      if (existing->getName() == "BaseObstacle") {
+        auto scored = std::make_shared<GoalAwareObstacleScore>(
+          existing, path_distance, costmap_ros_->getCostmap()->getResolution());
+        scored->initialize(node, "BaseObstacle", dwb_plugin_name_, costmap_ros_);
+        existing = scored;
+      } else if (existing->getName() == "GoalDist") {
+        auto scored = std::make_shared<GeodesicGoalScore>(existing);
+        scored->initialize(node, "GoalDist", dwb_plugin_name_, costmap_ros_);
+        existing = scored;
+      }
+    }
+    auto critic = std::make_shared<SpinCoverageCritic>();
+    critic->initialize(node, "SpinCoverage", dwb_plugin_name_, costmap_ros_);
+    critics_.push_back(critic);
+    RCLCPP_INFO(
+      logger_, "Added SpinCoverage critic: full physical spin circle vs lethal/unknown cells");
+  }
+
+public:
+  void configure(
+    const rclcpp_lifecycle::LifecycleNode::WeakPtr & parent, std::string name,
+    std::shared_ptr<tf2_ros::Buffer> tf,
+    std::shared_ptr<nav2_costmap_2d::Costmap2DROS> costmap_ros) override
+  {
+    dwb_core::DWBLocalPlanner::configure(parent, name, tf, costmap_ros);
+    auto node = parent.lock();
+    if (!node) {throw nav2_core::PlannerException("Cannot lock DWB parent");}
+    double angular_max = 1.0;
+    node->get_parameter(name + ".max_vel_theta", angular_max);
+    if (angular_max != 0.0) {
+      throw nav2_core::PlannerException("CollisionAwareOmniController requires max_vel_theta=0");
+    }
+    velocity_pub_ = node->create_publisher<geometry_msgs::msg::TwistStamped>(
+      name + "/estimated_velocity", rclcpp::SystemDefaultsQoS());
+    RCLCPP_INFO(logger_, "Omni DWB uses estimated pose velocity in the nonspinning command frame");
+  }
+  void activate() override
+  {
+    estimator_.reset(); pose_frame_.clear();
+    dwb_core::DWBLocalPlanner::activate(); velocity_pub_->on_activate();
+  }
+  void deactivate() override
+  {
+    velocity_pub_->on_deactivate(); dwb_core::DWBLocalPlanner::deactivate();
+  }
+  void cleanup() override
+  {
+    velocity_pub_.reset(); estimator_.reset(); dwb_core::DWBLocalPlanner::cleanup();
+  }
+  geometry_msgs::msg::TwistStamped computeVelocityCommands(
+    const geometry_msgs::msg::PoseStamped & pose, const geometry_msgs::msg::Twist &,
+    nav2_core::GoalChecker * goal_checker) override
+  {
+    if (pose_frame_ != pose.header.frame_id) {estimator_.reset(); pose_frame_ = pose.header.frame_id;}
+    const auto v = estimator_.update(
+      rclcpp::Time(pose.header.stamp).seconds(), pose.pose.position.x,
+      pose.pose.position.y, tf2::getYaw(pose.pose.orientation));
+    geometry_msgs::msg::Twist velocity;
+    velocity.linear.x = v.first; velocity.linear.y = v.second;
+    geometry_msgs::msg::TwistStamped observed;
+    observed.header = pose.header; observed.header.frame_id = costmap_ros_->getBaseFrameID();
+    observed.twist = velocity; velocity_pub_->publish(observed);
+    return dwb_core::DWBLocalPlanner::computeVelocityCommands(pose, velocity, goal_checker);
+  }
+};
+}  // namespace pb_omni_pid_pursuit_controller
+PLUGINLIB_EXPORT_CLASS(
+  pb_omni_pid_pursuit_controller::CollisionAwareOmniController, nav2_core::Controller)
diff --git a/test/test_collision_checked_lookahead.cpp b/test/test_collision_checked_lookahead.cpp
new file mode 100644
index 0000000..ad7bbf3
--- /dev/null
+++ b/test/test_collision_checked_lookahead.cpp
@@ -0,0 +1,47 @@
+// Copyright 2026 HardyYip contributors
+// SPDX-License-Identifier: Apache-2.0
+#include "pb_omni_pid_pursuit_controller/collision_checked_lookahead.hpp"
+#include <cassert>
+#include <fstream>
+#include <iostream>
+#include <limits>
+using namespace pb_omni_pid_pursuit_controller;
+int main(int argc, char ** argv)
+{
+  auto clear = [](double, double) {return true;};
+  auto wall = [](double x, double y) {return !(x > 0.2 && x < 0.25 && y < 0.1);};
+  assert(!collisionFreeSegment(0, 0, 0.5, 0, 0.05, wall));
+  assert(collisionFreeSegment(0, 0, 0.5, 0.5, 0.05, wall));
+  auto straight = collisionCheckedTarget({{0.1, 0}, {0.3, 0}, {0.5, 0}}, 0, 0, 0.05, clear);
+  assert(straight && *straight == 2);
+  auto bent = collisionCheckedTarget({{0.1, 0.3}, {0.5, 0}}, 0, 0, 0.05, wall);
+  assert(bent && *bent == 0);
+  auto known = [](double x, double) {return x <= 0.3;};
+  auto unknown = collisionCheckedTarget({{0.1, 0}, {0.5, 0}}, 0, 0, 0.05, known);
+  assert(unknown && *unknown == 0);
+  assert(!collisionCheckedTarget({{0.3, 0}}, 0, 0, 0.05, [](double, double) {return false;}));
+  assert(!collisionFreeSegment(0, 0, std::numeric_limits<double>::quiet_NaN(), 0, 0.05, clear));
+  assert(!collisionCheckedTarget({{0.001, 0}}, 0, 0, 0.05, clear));
+  assert(std::abs(shortTargetSpeedLimit(0.05, 0.25) - 0.2) < 1e-12);
+  assert(shortTargetSpeedLimit(0.05, 0) == 0);
+  assert(argc == 2);
+  std::ifstream input(argv[1]);
+  int width, height; double resolution, ox, oy, x0, y0; std::size_t count;
+  input >> width >> height >> resolution >> ox >> oy >> x0 >> y0;
+  std::vector<int> grid(width * height);
+  for (auto & value : grid) {input >> value;}
+  input >> count;
+  std::vector<std::pair<double, double>> points(count);
+  for (auto & point : points) {input >> point.first >> point.second;}
+  assert(input.good());
+  auto safe = [&](double x, double y) {
+      const int mx = std::floor((x - ox) / resolution);
+      const int my = std::floor((y - oy) / resolution);
+      return mx >= 0 && my >= 0 && mx < width && my < height && grid[my * width + mx] < 253;
+    };
+  assert(!collisionFreeSegment(x0, y0, points.back().first, points.back().second, resolution, safe));
+  auto replay = collisionCheckedTarget(points, x0, y0, resolution, safe);
+  assert(replay && *replay < count - 1);
+  std::cout << "9 collision-check contracts passed; recorded blocked target " << count - 1
+            << " shortened to " << *replay << '\n';
+}
diff --git a/test/test_geodesic_goal_field.cpp b/test/test_geodesic_goal_field.cpp
new file mode 100644
index 0000000..ab7b20f
--- /dev/null
+++ b/test/test_geodesic_goal_field.cpp
@@ -0,0 +1,87 @@
+#include "pb_omni_pid_pursuit_controller/geodesic_goal_field.hpp"
+#include <gtest/gtest.h>
+#include <random>
+#include <chrono>
+using pb_omni_pid_pursuit_controller::goal_field::Potential;
+using pb_omni_pid_pursuit_controller::goal_field::Point;
+struct FieldFixture : testing::Test
+{
+  std::vector<unsigned char> data = std::vector<unsigned char>(10000, 0);
+  c041_spin::GridView grid{0, 0, .05, 100, 100, data.data()};
+  Potential field;
+  double radius = .382883794 + .05;
+  bool prepare(Point start = {2.025, 2.025}, std::vector<Point> plan = {{3.025, 2.025}})
+  {return field.prepare(grid, start, plan, radius);}
+};
+TEST_F(FieldFixture, OpenFloorUsesOriginalCellUnits)
+{ASSERT_TRUE(prepare()); EXPECT_NEAR(field.score(2.025, 2.025), 20., 1.e-8); EXPECT_NEAR(field.score(3.025, 2.025), 0., 1.e-8);}
+TEST_F(FieldFixture, WallRequiresMovingAwayFromEuclideanGoal)
+{
+  for (int y = 0; y <= 60; ++y) {data[y * 100 + 50] = 254;}
+  ASSERT_TRUE(prepare());
+  EXPECT_GT(field.score(2.025, 2.025), 20.);
+  EXPECT_LT(field.score(2.025, 2.125), field.score(2.025, 2.025));
+}
+TEST_F(FieldFixture, UnreachableFinalGoalSelectsLastReachablePlanPoint)
+{
+  for (int y = 0; y < 100; ++y) {data[y * 100 + 50] = 254;}
+  ASSERT_TRUE(prepare({2.025, 2.025}, {{2.025, 2.025}, {3.025, 2.025}}));
+  EXPECT_EQ(field.targetPlanIndex(), 0);
+}
+TEST_F(FieldFixture, NoReachablePlanHasPositiveBoundedPenalty)
+{
+  for (int y = 0; y < 100; ++y) {data[y * 100 + 50] = 255;}
+  EXPECT_FALSE(prepare()); EXPECT_DOUBLE_EQ(field.score(2.025, 2.025), field.unreachableScore());
+}
+TEST_F(FieldFixture, UnknownAndLethalHaveSameSafetyMeaning)
+{
+  data[40 * 100 + 50] = 255; ASSERT_TRUE(prepare({1.025, 1.025}, {{1.025, 1.025}}));
+  EXPECT_FALSE(field.safeCell(50, 40));
+  data[40 * 100 + 50] = 254; ASSERT_TRUE(prepare({1.025, 1.025}, {{1.025, 1.025}}));
+  EXPECT_FALSE(field.safeCell(50, 40));
+}
+TEST_F(FieldFixture, InscribedCostKeepsExistingSpinKernelSemantics)
+{data[40 * 100 + 40] = 253; ASSERT_TRUE(prepare()); EXPECT_TRUE(field.safeCell(40, 40));}
+TEST_F(FieldFixture, DoesNotForceEscapeFromInvalidFirstPose)
+{data[40 * 100 + 40] = 254; EXPECT_FALSE(prepare()); EXPECT_EQ(field.targetPlanIndex(), -1);}
+TEST_F(FieldFixture, MapEdgeRetainsOriginalRejection)
+{EXPECT_FALSE(prepare({.1, .1})); EXPECT_FALSE(field.safeCell(0, 0));}
+TEST_F(FieldFixture, ContinuousAcrossCellCenterBoundary)
+{
+  ASSERT_TRUE(prepare()); EXPECT_LT(std::abs(field.score(2.025 - 1.e-7, 2.123) - field.score(2.025 + 1.e-7, 2.123)), 1.e-4);
+}
+TEST_F(FieldFixture, TranslationInvariant)
+{
+  ASSERT_TRUE(prepare()); double before = field.score(2.125, 2.125);
+  grid.origin_x = 10.; grid.origin_y = -20.; ASSERT_TRUE(prepare({12.025, -17.975}, {{13.025, -17.975}}));
+  EXPECT_NEAR(field.score(12.125, -17.875), before, 1.e-8);
+}
+TEST_F(FieldFixture, ResolutionScalingRetainsCellUnitScore)
+{grid.resolution = .1; radius *= 2.; ASSERT_TRUE(prepare({4.05, 4.05}, {{6.05, 4.05}})); EXPECT_NEAR(field.score(4.05, 4.05), 20., 1.e-8);}
+TEST_F(FieldFixture, PrepareClearsUnreachableState)
+{
+  ASSERT_TRUE(prepare()); for (int y = 0; y < 100; ++y) {data[y * 100 + 50] = 254;}
+  EXPECT_FALSE(prepare()); std::fill(data.begin(), data.end(), 0); ASSERT_TRUE(prepare()); EXPECT_NEAR(field.score(2.025, 2.025), 20., 1.e-8);
+}
+TEST_F(FieldFixture, DistanceTransformMatchesActualHardCircleAtEveryCell)
+{
+  std::mt19937 random(42);
+  for (int repeat = 0; repeat < 3; ++repeat) {
+    std::fill(data.begin(), data.end(), 0);
+    for (int i = 0; i < 10000; ++i) {
+      double x = (i % 100 + .5) * .05, y = (i / 100 + .5) * .05;
+      if (std::hypot(x - 1.025, y - 1.025) > .8 && random() % 150 == 0) {data[i] = random() % 2 ? 254 : 255;}
+    }
+    ASSERT_TRUE(prepare({1.025, 1.025}, {{1.025, 1.025}}));
+    for (int y = 0; y < 100; ++y) {for (int x = 0; x < 100; ++x) {
+      ASSERT_EQ(field.safeCell(x, y), c041_spin::circleClear(grid, (x + .5) * .05, (y + .5) * .05, radius)) << x << "," << y;
+    }}
+  }
+}
+
+TEST_F(FieldFixture, ClearanceDistancePrefersRoomOverGrazingWall)
+{
+  for (int y = 0; y <= 60; ++y) {data[y * 100 + 50] = 254;}
+  ASSERT_TRUE(prepare());
+  EXPECT_GT(field.score(2.075, 2.025), field.score(1.975, 2.025));
+}
