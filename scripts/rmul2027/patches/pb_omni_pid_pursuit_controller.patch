+// Copyright 2026 HardyYip contributors
+// SPDX-License-Identifier: Apache-2.0
+#include "pb_omni_pid_pursuit_controller/pose_velocity_estimator.hpp"
+#include <cassert>
+#include <cmath>
+#include <iostream>
+#include <limits>
+using pb_omni_pid_pursuit_controller::PoseVelocityEstimator;
+int main()
+{
+  PoseVelocityEstimator estimator;
+  auto v = estimator.update(1.0, 0.0, 0.0, 0.0);
+  assert(v.first == 0.0 && v.second == 0.0);
+  for (int i = 1; i <= 20; ++i) {v = estimator.update(1.0 + i * .05, i * .015, i * .02, 0.0);}
+  assert(std::abs(v.first - .3) < 1e-10 && std::abs(v.second - .4) < 1e-10);
+  v = estimator.update(2.0, .3, .4, 3.14159265358979323846 / 2.0);
+  assert(std::abs(v.first - .4) < 1e-10 && std::abs(v.second + .3) < 1e-10);
+  v = estimator.update(2.0, 100.0, 100.0, 0.0);
+  assert(std::abs(v.first - .3) < 1e-10 && std::abs(v.second - .4) < 1e-10);
+  v = estimator.update(.5, 1.0, 2.0, 0.0);
+  assert(v.first == 0.0 && v.second == 0.0);
+  estimator.update(.55, 1.02, 2.0, 0.0);
+  v = estimator.update(2.0, 3.0, 2.0, 0.0);
+  assert(v.first == 0.0 && v.second == 0.0);
+  v = estimator.update(std::numeric_limits<double>::quiet_NaN(), 0, 0, 0);
+  assert(v.first == 0.0 && v.second == 0.0);
+  std::cout << "7 pose-velocity contracts passed\n";
+}
