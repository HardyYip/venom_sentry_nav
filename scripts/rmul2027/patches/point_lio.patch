diff --git a/src/timing_diagnostics.h b/src/timing_diagnostics.h
new file mode 100644
index 0000000000000000000000000000000000000000..a729ecfc421b7a9e975127f488fd6a8bdad411d0
--- /dev/null
+++ b/src/timing_diagnostics.h
@@ -0,0 +1,178 @@
+#pragma once
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <iomanip>
+#include <limits>
+#include <memory>
+#include <sstream>
+#include <utility>
+#include <vector>
+#include <rclcpp/rclcpp.hpp>
+
+class TimingDiagnostics
+{
+public:
+  void configure(const std::shared_ptr<rclcpp::Node> & node, bool enabled, double imu_period)
+  {
+    node_ = node;
+    enabled_ = enabled;
+    imu_period_ = imu_period;
+    report_time_ = Clock::now();
+  }
+
+  bool enabled() const { return enabled_; }
+
+  void imu(double stamp)
+  {
+    if (!enabled_) return;
+    ++imu_count_;
+    ++window_imu_count_;
+    if (last_imu_stamp_ >= 0.0) {
+      const double dt = stamp - last_imu_stamp_;
+      imu_max_gap_ = std::max(imu_max_gap_, dt);
+      window_imu_max_gap_ = std::max(window_imu_max_gap_, dt);
+      if (dt < 0.0) ++imu_backwards_;
+      if (imu_period_ > 0.0 && dt > imu_period_ * 1.5) {
+        ++imu_gap_count_;
+        imu_missing_estimate_ += std::max(0LL, std::llround(dt / imu_period_) - 1);
+        if (window_gaps_.size() < 200) window_gaps_.emplace_back(last_imu_stamp_, stamp);
+      }
+    }
+    last_imu_stamp_ = stamp;
+    if (auto node = node_.lock()) {
+      window_imu_max_age_ = std::max(window_imu_max_age_, node->now().seconds() - stamp);
+    }
+  }
+
+  template<typename Cloud>
+  void lidar(double stamp, const Cloud & cloud, double preprocessing_wall)
+  {
+    if (!enabled_) return;
+    ++lidar_count_;
+    ++window_lidar_count_;
+    if (last_lidar_stamp_ >= 0.0) {
+      window_lidar_max_gap_ = std::max(window_lidar_max_gap_, stamp - last_lidar_stamp_);
+    }
+    last_lidar_stamp_ = stamp;
+    point_count_ = cloud.points.size();
+    point_offset_min_ = std::numeric_limits<double>::infinity();
+    point_offset_max_ = 0.0;
+    for (const auto & point : cloud.points) {
+      point_offset_min_ = std::min(point_offset_min_, point.curvature / 1000.0);
+      point_offset_max_ = std::max(point_offset_max_, point.curvature / 1000.0);
+    }
+    if (cloud.points.empty()) point_offset_min_ = 0.0;
+    window_preprocess_max_ = std::max(window_preprocess_max_, preprocessing_wall);
+    if (auto node = node_.lock()) {
+      window_lidar_max_age_ = std::max(window_lidar_max_age_, node->now().seconds() - stamp);
+    }
+  }
+
+  void scan(double begin, double end, double elapsed)
+  {
+    if (!enabled_) return;
+    ++scan_count_;
+    scan_begin_ = begin;
+    scan_end_ = end;
+    window_scan_max_ = std::max(window_scan_max_, elapsed);
+  }
+
+  void report(size_t imu_buffer, size_t lidar_buffer, bool force = false)
+  {
+    if (!enabled_) return;
+    const auto now = Clock::now();
+    const double window = std::chrono::duration<double>(now - report_time_).count();
+    if (!force && window < 1.0) return;
+    auto node = node_.lock();
+    if (!node) return;
+    std::ostringstream output;
+    output << std::setprecision(15)
+      << "{\"event\":\"point_lio_timing\",\"sim_time\":" << node->now().seconds()
+      << ",\"window_wall_s\":" << window
+      << ",\"imu_count\":" << imu_count_
+      << ",\"window_imu_count\":" << window_imu_count_
+      << ",\"last_imu_stamp\":" << last_imu_stamp_
+      << ",\"imu_max_gap_s\":" << imu_max_gap_
+      << ",\"window_imu_max_gap_s\":" << window_imu_max_gap_
+      << ",\"imu_gap_count\":" << imu_gap_count_
+      << ",\"imu_missing_intervals_estimate\":" << imu_missing_estimate_
+      << ",\"imu_backwards\":" << imu_backwards_
+      << ",\"imu_max_age_s\":" << window_imu_max_age_
+      << ",\"lidar_count\":" << lidar_count_
+      << ",\"window_lidar_count\":" << window_lidar_count_
+      << ",\"last_lidar_stamp\":" << last_lidar_stamp_
+      << ",\"lidar_max_gap_s\":" << window_lidar_max_gap_
+      << ",\"lidar_max_age_s\":" << window_lidar_max_age_
+      << ",\"point_count\":" << point_count_
+      << ",\"point_offset_min_s\":" << point_offset_min_
+      << ",\"point_offset_max_s\":" << point_offset_max_
+      << ",\"preprocessing_wall_max_s\":" << window_preprocess_max_
+      << ",\"scan_count\":" << scan_count_
+      << ",\"scan_begin\":" << scan_begin_
+      << ",\"scan_end\":" << scan_end_
+      << ",\"scan_processing_wall_max_s\":" << window_scan_max_
+      << ",\"internal_imu_buffer\":" << imu_buffer
+      << ",\"internal_lidar_buffer\":" << lidar_buffer
+      << ",\"imu_gaps\":[";
+    for (size_t i = 0; i < window_gaps_.size(); ++i) {
+      if (i) output << ',';
+      output << '[' << window_gaps_[i].first << ',' << window_gaps_[i].second << ']';
+    }
+    output << "]}";
+    RCLCPP_INFO(node->get_logger(), "%s", output.str().c_str());
+    report_time_ = now;
+    window_imu_count_ = window_lidar_count_ = 0;
+    window_imu_max_gap_ = window_lidar_max_gap_ = 0.0;
+    window_imu_max_age_ = window_lidar_max_age_ = 0.0;
+    window_preprocess_max_ = window_scan_max_ = 0.0;
+    window_gaps_.clear();
+  }
+
+private:
+  using Clock = std::chrono::steady_clock;
+  bool enabled_ = false;
+  std::weak_ptr<rclcpp::Node> node_;
+  Clock::time_point report_time_;
+  double imu_period_ = 0.005;
+  double last_imu_stamp_ = -1.0, last_lidar_stamp_ = -1.0;
+  double imu_max_gap_ = 0.0, window_imu_max_gap_ = 0.0;
+  double window_lidar_max_gap_ = 0.0;
+  double window_imu_max_age_ = 0.0, window_lidar_max_age_ = 0.0;
+  double point_offset_min_ = 0.0, point_offset_max_ = 0.0;
+  double window_preprocess_max_ = 0.0, window_scan_max_ = 0.0;
+  double scan_begin_ = 0.0, scan_end_ = 0.0;
+  size_t imu_count_ = 0, lidar_count_ = 0, scan_count_ = 0, point_count_ = 0;
+  size_t window_imu_count_ = 0, window_lidar_count_ = 0;
+  size_t imu_gap_count_ = 0, imu_backwards_ = 0;
+  long long imu_missing_estimate_ = 0;
+  std::vector<std::pair<double, double>> window_gaps_;
+};
+
+inline TimingDiagnostics & timing_probe()
+{
+  static TimingDiagnostics value;
+  return value;
+}
+
+class TimingScanScope
+{
+public:
+  TimingScanScope(double begin, double end)
+  : enabled_(timing_probe().enabled()), begin_(begin), end_(end)
+  {
+    if (enabled_) started_ = std::chrono::steady_clock::now();
+  }
+  ~TimingScanScope()
+  {
+    if (enabled_) {
+      timing_probe().scan(begin_, end_,
+        std::chrono::duration<double>(std::chrono::steady_clock::now() - started_).count());
+    }
+  }
+private:
+  bool enabled_;
+  double begin_, end_;
+  std::chrono::steady_clock::time_point started_;
+};
