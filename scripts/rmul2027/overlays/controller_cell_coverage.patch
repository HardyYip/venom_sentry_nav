 struct Point {double x, y;};
+// Enforce the same complete-cell reserve along the continuous trajectory.
+// A physically clear start inside the reserve may move outward, never inward.
+inline bool trajectoryReserveClear(
+  const c041_spin::GridView & grid, const std::vector<Point> & points, double radius)
+{
+  if (points.empty() || !grid.data || grid.width < 2 || grid.height < 2 ||
+    !std::isfinite(grid.resolution) || grid.resolution <= 0.0 ||
+    !std::isfinite(radius) || radius < 0.0) {return false;}
+  const double reserve = std::hypot(grid.resolution, grid.resolution) / 2.0;
+  const double required = radius + reserve;
+  double previous = 0.0;
+  bool first = true, established = false;
+  const auto check = [&](Point p) {
+    if (!std::isfinite(p.x) || !std::isfinite(p.y) ||
+      !c041_spin::circleClear(grid, p.x, p.y, radius)) {return false;}
+    const double distance = c041_spin::nearestHardDistance(grid, p.x, p.y, required);
+    if (!first && ((established && distance < required - 1.0e-9) ||
+      (!established && distance < previous - 1.0e-9))) {return false;}
+    first = false; established = established || distance >= required - 1.0e-9;
+    previous = distance;
+    return true;
+  };
+  if (!check(points.front())) {return false;}
+  for (std::size_t k = 1; k < points.size(); ++k) {
+    const Point a = points[k - 1], b = points[k];
+    if (!std::isfinite(b.x) || !std::isfinite(b.y) ||
+      !c041_spin::circleClear(grid, b.x, b.y, radius)) {return false;}
+    const int steps = std::max(1, static_cast<int>(std::ceil(
+      std::hypot(b.x - a.x, b.y - a.y) / (0.5 * grid.resolution))));
+    for (int j = 1; j <= steps; ++j) {
+      const double t = static_cast<double>(j) / steps;
+      if (!check({a.x + t * (b.x - a.x), a.y + t * (b.y - a.y)})) {return false;}
+    }
+  }
+  return true;
+}
